{
	"name": "tonic-for-gitlab",
	"version": "0.1.0",
	"private": true,
	"homepage": "https://github.com/beeyev/tonic-for-gitlab",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev:chrome": "extension dev --browser chrome",
		"dev:firefox": "extension dev --browser firefox",
		"preview:chrome": "extension preview --browser chrome",
		"preview:firefox": "extension preview --browser firefox",
		"browsers:install": "TMPDIR=/tmp BUN_INSTALL_CACHE_DIR=.cache/bun extension install --browser chrome,firefox",
		"browsers:where": "extension install --browser chrome,firefox --where --output json",
		"format": "biome format --write .",
		"fix": "biome check --write .",
		"check": "biome check --error-on-warnings . && tsc --noEmit",
		"test": "bun test --preload @happy-dom/global-registrator/register",
		"release:validate-version": "bun tooling/release/version.ts",
		"release:pack": "bun tooling/release/pack.ts",
		"build": "extension build --browser chrome,firefox && bun lab/extension/check-shipping-manifests.ts",
		"verify": "bun run check && bun run test && bun run build"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.6",
		"@happy-dom/global-registrator": "21.0.4",
		"@tailwindcss/postcss": "4.3.5",
		"@testing-library/dom": "10.4.2",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/bun": "1.4.4",
		"@types/chrome": "0.3.7",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.7",
		"@webext-core/fake-browser": "2.0.1",
		"extension": "4.1.39",
		"happy-dom": "21.0.4",
		"tailwindcss": "4.3.5",
		"typescript": "7.0.2"
	}
}
